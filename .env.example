# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in what you have. Everything except the
# Google Calendar section is optional — the app runs and degrades gracefully
# (logging instead of sending) when an integration isn't configured.
# ---------------------------------------------------------------------------

# --- Vapi (needed only for OUTBOUND calling) -------------------------------
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# --- Google Calendar (required for appointment booking) --------------------
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_CALENDAR_ID=
TIMEZONE=Asia/Kolkata

# --- Business identity and hours -------------------------------------------
BUSINESS_NAME=Wellness Partners
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=17
SATURDAY_END_HOUR=12
# Monday=0 ... Sunday=6
BUSINESS_DAYS=0,1,2,3,4,5
DEFAULT_APPOINTMENT_MINUTES=30

# --- Notifications (all free-tier friendly, all optional) ------------------
# Slack incoming webhook — free on any Slack workspace
SLACK_WEBHOOK_URL=

# Gmail SMTP — free, needs a Google "App Password" (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SALES_TEAM_EMAIL=

# --- CRM sync (any webhook-capable CRM: HubSpot free, Sheets, GoHighLevel) --
CRM_WEBHOOK_URL=

# --- Workflow automation (Zapier / Make / n8n webhook) ---------------------
AUTOMATION_WEBHOOK_URL=

# --- Live call transfer ----------------------------------------------------
ESCALATION_PHONE_NUMBER=

# --- Server ----------------------------------------------------------------
APP_ENV=development
PORT=8000
